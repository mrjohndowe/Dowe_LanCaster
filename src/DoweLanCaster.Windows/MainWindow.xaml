<Window x:Class="DoweLanCaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dowe LanCaster" Height="860" Width="1220" MinHeight="760" MinWidth="1040" WindowStartupLocation="CenterScreen">
        <Grid Margin="18">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Roku:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="DeviceComboBox" Grid.Column="2" MinWidth="420" Height="32" SelectionChanged="DeviceComboBox_SelectionChanged"/>
                                        <Button x:Name="ScanButton" Grid.Column="4" Content="Scan for Roku Devices" Padding="18,6" Click="ScanButton_Click"/>
                                        <TextBlock x:Name="CurrentVersionText" Grid.Column="6" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Button x:Name="CheckForUpdatesButton" Grid.Column="8" Content="Check for Updates" Padding="12,6" Click="CheckForUpdatesButton_Click"/>
                                        <CheckBox x:Name="DarkModeCheckBox" Grid.Column="10" Content="Dark Mode" VerticalAlignment="Center" Checked="DarkModeCheckBox_Changed" Unchecked="DarkModeCheckBox_Changed"/>
                                </Grid>
                        </Border>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Manual IP:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBox x:Name="ManualRokuIpTextBox" Grid.Column="2" Height="30" VerticalContentAlignment="Center" ToolTip="Example: 10.0.0.105"/>
                                        <Button Grid.Column="4" Content="Add Roku by IP" Width="130" Click="AddRokuByIpButton_Click"/>
                                </Grid>
                        </Border>
                </StackPanel>

                <TabControl Grid.Row="2">


                        <TabItem Header="Link Cast">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16">

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                        <StackPanel>
                                                                <TextBlock Text="Stream a Video Link" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Paste a public, non-DRM webpage, direct media URL, or TeraBox share link. Dowe LanCaster extracts the media, converts it to Roku-friendly HLS, and streams it over your LAN." TextWrapping="Wrap" Opacity="0.78" Margin="0,0,0,14"/>
                                                                <TextBlock Text="Video URL" FontWeight="SemiBold"/>
                                                                <TextBox x:Name="LinkUrlTextBox" Height="36" Margin="0,6,0,12" VerticalContentAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                        <Button x:Name="AnalyzeLinkButton" Content="Analyze Link" Width="140" Height="40" Margin="0,0,10,0" Click="AnalyzeLinkButton_Click"/>
                                                                        <Button x:Name="StreamLinkButton" Content="Stream to Roku" Width="150" Height="40" Margin="0,0,10,0" IsEnabled="False" Click="StreamLinkButton_Click"/>
                                                                        <Button x:Name="StopLinkButton" Content="Stop Link Stream" Width="150" Height="40" IsEnabled="False" Click="StopLinkButton_Click"/>
                                                                </StackPanel>

                                                                <TextBlock Text="Encoder, quality, and audio defaults are set in the Settings tab." Margin="0,14,0,0" Opacity="0.78" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </Border>

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="160"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" Text="Title" FontWeight="SemiBold" Margin="0,4"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LinkTitleText" Text="-" TextWrapping="Wrap" Margin="0,4"/>
                                                                <TextBlock Grid.Row="1" Text="Protocol" FontWeight="SemiBold" Margin="0,4"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LinkProtocolText" Text="-" Margin="0,4"/>
                                                                <TextBlock Grid.Row="2" Text="Source type" FontWeight="SemiBold" Margin="0,4"/>
                                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LinkTypeText" Text="-" Margin="0,4"/>
                                                                <TextBlock Grid.Row="3" Text="Roku stream" FontWeight="SemiBold" Margin="0,4"/>
                                                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="LinkStreamUrlTextBox" IsReadOnly="True" Height="32" VerticalContentAlignment="Center" Margin="0,4"/>
                                                                <TextBlock Grid.Row="4" Text="Status" FontWeight="SemiBold" Margin="0,4"/>
                                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LinkStatusText" Text="Ready. Paste a URL and click Analyze Link." TextWrapping="Wrap" Margin="0,4"/>
                                                        </Grid>
                                                </Border>

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                                        <StackPanel>
                                                                <TextBlock Text="Compatibility" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Works with direct media links, TeraBox streaming URLs, public TeraBox video shares, and many sites supported by yt-dlp. TeraBox URLs containing /share/streaming and M3U8 parameters are detected as HLS. Keep TeraBox shares public and use the latest yt-dlp from SETUP-DEPENDENCIES.cmd. DRM-protected video, paywalled streams, sign-in-only shares, or sites that block extraction are not bypassed." TextWrapping="Wrap" Opacity="0.78"/>
                                                        </StackPanel>
                                                </Border>

                                        </StackPanel>
                                </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Live Cast">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16">

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                        <StackPanel>
                                                                <TextBlock Text="Capture Source" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                                                                <ComboBox x:Name="CaptureSourceComboBox" Height="34" Margin="0,0,0,10"/>
                                                                <Button Content="Refresh Screens / Windows" HorizontalAlignment="Left" Padding="14,6" Click="RefreshCaptureSourcesButton_Click"/>
                                                                <TextBlock Text="Encoder, frame rate, quality, and audio defaults are set in the Settings tab. Live mode uses a short rolling HLS playlist with 2-second segments." Margin="0,12,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </Border>

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                                        <StackPanel>
                                                                <TextBlock Text="Live Stream" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                                                                <TextBox x:Name="LiveStreamUrlTextBox" Height="34" IsReadOnly="True" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                        <Button x:Name="StartLiveButton" Content="Start Live Cast" Width="150" Height="44" Margin="0,0,10,0" Click="StartLiveButton_Click"/>
                                                                        <Button x:Name="StopLiveButton" Content="Stop Live Cast" Width="150" Height="44" IsEnabled="False" Click="StopLiveButton_Click"/>
                                                                </StackPanel>
                                                                <TextBlock x:Name="LiveStatusText" Text="Select a source and Roku device." Margin="0,12,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </Border>

                                        </StackPanel>
                                </ScrollViewer>
                        </TabItem>


                        <TabItem Header="Folder Cast">
                                <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Folder:" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                        <TextBox x:Name="FolderPathTextBox" Grid.Column="2" Height="34" IsReadOnly="True" VerticalContentAlignment="Center"/>

                                                        <Button Grid.Column="4" Content="Choose Folder..." Width="140" Height="34" Click="ChooseFolderButton_Click"/>
                                                </Grid>
                                        </Border>

                                        <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="280"/>
                                                </Grid.ColumnDefinitions>

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                        <Grid>
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="8"/>
                                                                        <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <DockPanel>
                                                                        <TextBlock Text="Playlist" FontSize="22" FontWeight="Bold" DockPanel.Dock="Left"/>

                                                                        <TextBlock x:Name="FolderCountText" Text="0 videos" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                </DockPanel>

                                                                <ListBox x:Name="FolderPlaylistListBox" Grid.Row="2" DisplayMemberPath="FileName" MouseDoubleClick="FolderPlaylistListBox_MouseDoubleClick"/>
                                                        </Grid>
                                                </Border>

                                                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                                        <StackPanel>
                                                                <TextBlock Text="Playlist Options" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                                                                <CheckBox x:Name="FolderIncludeSubfoldersCheckBox" Content="Include subfolders" IsChecked="True" Margin="0,0,0,10" Checked="FolderOptionChanged" Unchecked="FolderOptionChanged"/>

                                                                <CheckBox x:Name="FolderShuffleCheckBox" Content="Shuffle" Margin="0,0,0,10"/>

                                                                <CheckBox x:Name="FolderAutoPlayCheckBox" Content="Auto-play next" IsChecked="True" Margin="0,0,0,10"/>

                                                                <TextBlock Text="Repeat" FontWeight="SemiBold"/>
                                                                <ComboBox x:Name="FolderRepeatComboBox" Height="32" Margin="0,5,0,14" SelectedIndex="0">
                                                                        <ComboBoxItem Content="Off"/>
                                                                        <ComboBoxItem Content="One"/>
                                                                        <ComboBoxItem Content="All"/>
                                                                </ComboBox>

                                                                <TextBlock Text="Encoder and quality defaults are set in the Settings tab." Margin="0,0,0,14" Opacity="0.78" TextWrapping="Wrap"/>

                                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                                        <Button Content="Move Up" Height="34" Margin="0,0,4,0" Click="FolderMoveUpButton_Click"/>
                                                                        <Button Content="Move Down" Height="34" Margin="4,0,0,0" Click="FolderMoveDownButton_Click"/>
                                                                </UniformGrid>

                                                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                                                        <Button Content="Sort A-Z" Height="34" Margin="0,0,4,0" Click="FolderSortAscendingButton_Click"/>
                                                                        <Button Content="Sort Z-A" Height="34" Margin="4,0,0,0" Click="FolderSortDescendingButton_Click"/>
                                                                </UniformGrid>

                                                                <Button Content="Rescan Folder" Height="34" Margin="0,0,0,8" Click="RescanFolderButton_Click"/>

                                                                <Button Content="Shuffle Now" Height="34" Click="ShuffleFolderButton_Click"/>
                                                        </StackPanel>
                                                </Border>
                                        </Grid>

                                        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="FolderPreviousButton" Content="Previous" Width="100" Height="40" IsEnabled="False" Click="FolderPreviousButton_Click"/>

                                                        <Button x:Name="FolderPlayButton" Grid.Column="2" Content="Play" Width="100" Height="40" IsEnabled="False" Click="FolderPlayButton_Click"/>

                                                        <Button x:Name="FolderNextButton" Grid.Column="4" Content="Next" Width="100" Height="40" IsEnabled="False" Click="FolderNextButton_Click"/>

                                                        <Button x:Name="FolderStopButton" Grid.Column="6" Content="Stop" Width="100" Height="40" IsEnabled="False" Click="FolderStopButton_Click"/>

                                                        <StackPanel Grid.Column="7" Margin="18,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock x:Name="FolderNowPlayingText" Text="Nothing playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock x:Name="FolderProgressText" Text="0 of 0" Opacity="0.72"/>
                                                        </StackPanel>
                                                </Grid>
                                        </Border>

                                </Grid>
                        </TabItem>

                        <TabItem Header="File Cast">
                                <StackPanel Margin="16">
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                <StackPanel>
                                                        <TextBlock Text="Cast from PC" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                                                        <DockPanel>
                                                                <Button Content="Choose Video File..." Width="160" DockPanel.Dock="Right" Click="ChooseFileButton_Click"/>
                                                                <TextBox x:Name="SelectedFileTextBox" Height="34" IsReadOnly="True" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                                                        </DockPanel>
                                                </StackPanel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                                <StackPanel>
                                                        <TextBlock Text="Stream" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                                                        <TextBox x:Name="StreamUrlTextBox" IsReadOnly="True" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal">
                                                                <Button x:Name="CastButton" Content="Cast to Roku" Width="150" Height="44" Margin="0,0,10,0" Click="CastButton_Click"/>
                                                                <Button x:Name="StopCastingButton" Content="Stop Casting" Width="150" Height="44" IsEnabled="False" Click="StopCastingButton_Click"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="CastStatusText" Text="Choose a file and Roku device." Margin="0,12,0,0"/>
                                                </StackPanel>
                                        </Border>
                                </StackPanel>
                        </TabItem>

                        <TabItem Header="Remote">
                                <Grid Margin="16">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="EmbeddedRemoteColumn" Width="430"/>
                                                <ColumnDefinition x:Name="EmbeddedRemoteGapColumn" Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.Resources>
                                                <Style x:Key="RemoteRoundButtonStyle" TargetType="Button">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Background" Value="#2A2E35"/>
                                                        <Setter Property="BorderBrush" Value="#454B55"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                                <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="RemoteButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="RemoteButtonBorder" Property="Background" Value="#3A414B"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsPressed" Value="True">
                                                                                                <Setter TargetName="RemoteButtonBorder" Property="Background" Value="#149EC2"/>
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                                                <Setter TargetName="RemoteButtonBorder" Property="Opacity" Value="0.45"/>
                                                                                        </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                </Setter.Value>
                                                        </Setter>
                                                </Style>

                                                <Style x:Key="RemoteAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource RemoteRoundButtonStyle}">
                                                        <Setter Property="Background" Value="#15AFCF"/>
                                                        <Setter Property="BorderBrush" Value="#3FE1FF"/>
                                                        <Setter Property="Foreground" Value="#06151B"/>
                                                </Style>

                                                <Style x:Key="RemotePowerButtonStyle" TargetType="Button" BasedOn="{StaticResource RemoteRoundButtonStyle}">
                                                        <Setter Property="Background" Value="#A83A3A"/>
                                                        <Setter Property="BorderBrush" Value="#EE7777"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                        </Grid.Resources>

                                        <Viewbox x:Name="EmbeddedRemoteViewbox" Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                <Border Width="390" HorizontalAlignment="Center" Background="#15181D" BorderBrush="#3B414A" BorderThickness="2" CornerRadius="52" Padding="24" SnapsToDevicePixels="True">
                                                        <Border.Effect>
                                                                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.35"/>
                                                        </Border.Effect>

                                                        <StackPanel>
                                                                <TextBlock Text="DOWE LANCASTER" Foreground="#4EDCFF" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                                                <TextBlock Text="ROKU REMOTE" Foreground="#AAB3BE" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,22"/>

                                                                <Button Content="Open Pop-out Remote" Style="{StaticResource RemoteAccentButtonStyle}" Height="40" Margin="4,0,4,12" Click="OpenRemoteWindowButton_Click"/>

                                                                <UniformGrid Columns="4" Margin="0,0,0,14">
                                                                        <Button Content="↩ Back" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="44" Tag="Back" Click="RemoteButton_Click"/>
                                                                        <Button Content="⌂ Home" Style="{StaticResource RemoteAccentButtonStyle}" Margin="4" Height="44" Tag="Home" Click="RemoteButton_Click"/>
                                                                        <Button Content="↶ Replay" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="44" Tag="InstantReplay" Click="RemoteButton_Click"/>
                                                                        <Button Content="⏻ Power" ToolTip="Power control for compatible Roku TVs" Style="{StaticResource RemotePowerButtonStyle}" Margin="4" Height="44" Tag="Power" Click="RemoteButton_Click"/>
                                                                </UniformGrid>

                                                                <Border Background="#20242A" BorderBrush="#343A43" BorderThickness="1" CornerRadius="86" Width="250" Height="250" HorizontalAlignment="Center" Padding="14" Margin="0,4,0,14">
                                                                        <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="*"/>
                                                                                        <RowDefinition Height="*"/>
                                                                                        <RowDefinition Height="*"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <Button Grid.Row="0" Grid.Column="1" Content="▲" FontSize="24" Style="{StaticResource RemoteRoundButtonStyle}" Margin="5" Tag="Up" Click="RemoteButton_Click"/>

                                                                                <Button Grid.Row="1" Grid.Column="0" Content="◀" FontSize="24" Style="{StaticResource RemoteRoundButtonStyle}" Margin="5" Tag="Left" Click="RemoteButton_Click"/>

                                                                                <Button Grid.Row="1" Grid.Column="1" Content="OK" FontSize="18" Style="{StaticResource RemoteAccentButtonStyle}" Margin="2" Tag="Select" Click="RemoteButton_Click"/>

                                                                                <Button Grid.Row="1" Grid.Column="2" Content="▶" FontSize="24" Style="{StaticResource RemoteRoundButtonStyle}" Margin="5" Tag="Right" Click="RemoteButton_Click"/>

                                                                                <Button Grid.Row="2" Grid.Column="1" Content="▼" FontSize="24" Style="{StaticResource RemoteRoundButtonStyle}" Margin="5" Tag="Down" Click="RemoteButton_Click"/>
                                                                        </Grid>
                                                                </Border>

                                                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                                                        <Button Content="⏪" ToolTip="Rewind" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="48" Tag="Rev" Click="RemoteButton_Click"/>
                                                                        <Button Content="⏯" ToolTip="Play / Pause" FontSize="21" Style="{StaticResource RemoteAccentButtonStyle}" Margin="4" Height="48" Tag="Play" Click="RemoteButton_Click"/>
                                                                        <Button Content="⏩" ToolTip="Fast Forward" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="48" Tag="Fwd" Click="RemoteButton_Click"/>
                                                                </UniformGrid>

                                                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                                                        <Button Content="Vol −" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="44" Tag="VolumeDown" Click="RemoteButton_Click"/>
                                                                        <Button Content="Mute" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="44" Tag="VolumeMute" Click="RemoteButton_Click"/>
                                                                        <Button Content="Vol +" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Height="44" Tag="VolumeUp" Click="RemoteButton_Click"/>
                                                                </UniformGrid>

                                                                <Grid Margin="4,0,4,10">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="110"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox x:Name="VolumeLevelTextBox" Text="25" Height="42" Padding="12,0" VerticalContentAlignment="Center" ToolTip="Roku TV volume, from 0 to 100"/>
                                                                        <Button Grid.Column="1" Content="Set Volume" Style="{StaticResource RemoteAccentButtonStyle}" Height="42" Margin="8,0,0,0" Click="SetVolumeButton_Click"/>
                                                                </Grid>

                                                                <Button x:Name="HeadphoneModeButton" Content="🎧  Start Roku Private Listening" Style="{StaticResource RemoteRoundButtonStyle}" Height="46" Margin="4,0,4,10" Click="HeadphoneModeButton_Click"/>
                                                                <TextBlock x:Name="HeadphoneStatusText" Text="Private Listening is off." Foreground="#AAB3BE" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="8,0,8,12"/>

                                                                <Button x:Name="VoiceControlButton" Content="🎤  Start Voice Control" Style="{StaticResource RemoteAccentButtonStyle}" Height="48" Margin="4,2,4,4" Click="VoiceControlButton_Click"/>

                                                                <TextBlock x:Name="VoiceStatusText" Text="Voice control is off" Foreground="#AAB3BE" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,16"/>

                                                                <TextBlock Text="Keyboard Text" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="4,0,0,7"/>

                                                                <Grid Margin="4,0,4,8">
                                                                        <TextBox x:Name="RokuTextInput" Height="62" Padding="14,10" FontSize="16" VerticalContentAlignment="Center" TextChanged="RokuTextInput_TextChanged"/>
                                                                        <TextBlock x:Name="RokuTextPlaceholder" Text="Type or dictate text to your Roku..." Foreground="#7E8996" FontSize="15" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,10,0"/>
                                                                </Grid>

                                                                <Button Content="Send Text to Roku" Style="{StaticResource RemoteAccentButtonStyle}" Height="46" Margin="4,0,4,6" Click="SendTextButton_Click"/>
                                                        </StackPanel>
                                                </Border>
                                        </Viewbox>

                                        <Border x:Name="PopoutRemotePlaceholder" Grid.Column="0" Visibility="Collapsed" Width="390" HorizontalAlignment="Center" Background="#15181D" BorderBrush="#3B414A" BorderThickness="2" CornerRadius="52" Padding="24">
                                                <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="DOWE LANCASTER" Foreground="#4EDCFF" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="ROKU REMOTE" Foreground="#AAB3BE" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,32"/>
                                                        <TextBlock Text="Remote is open in its pop-out window" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                                        <Button Content="Bring Pop-out Remote Forward" Style="{StaticResource RemoteAccentButtonStyle}" Height="42" Margin="4,24,4,0" Click="OpenRemoteWindowButton_Click"/>
                                                </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="Installed Roku Apps" FontSize="24" FontWeight="Bold"/>
                                                        <Button Grid.Row="0" Content="Pop-out Remote" HorizontalAlignment="Right" Padding="12,6" Click="OpenRemoteWindowButton_Click" ToolTip="Open the resizable Roku Remote window"/>

                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12">
                                                                <Button Content="Refresh Apps" Padding="14,6" Click="RefreshAppsButton_Click"/>
                                                                <TextBlock Text="Display:" VerticalAlignment="Center" Margin="18,0,6,0"/>
                                                                <RadioButton x:Name="AppsListViewButton" Content="List" VerticalAlignment="Center" Margin="0,0,10,0" Checked="AppsDisplayMode_Changed"/>
                                                                <RadioButton x:Name="AppsGridViewButton" Content="Grid" IsChecked="True" VerticalAlignment="Center" Checked="AppsDisplayMode_Changed"/>
                                                        </StackPanel>

                                                        <Grid Grid.Row="2">
                                                                <ListBox x:Name="AppsListBox" Visibility="Collapsed" MouseDoubleClick="AppsListBox_MouseDoubleClick">
                                                                        <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Margin="4">
                                                                                                <Border Width="42" Height="42" Background="#20242A" CornerRadius="5" Margin="0,0,10,0">
                                                                                                        <Image Source="{Binding IconUrl}" Stretch="Uniform"/>
                                                                                                </Border>
                                                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                                        </StackPanel>
                                                                                </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                </ListBox>

                                                                <ListBox x:Name="AppsGridListBox" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="AppsListBox_MouseDoubleClick">
                                                                        <ListBox.ItemContainerStyle>
                                                                                <Style TargetType="ListBoxItem">
                                                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                                </Style>
                                                                        </ListBox.ItemContainerStyle>
                                                                        <ListBox.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                        <UniformGrid Columns="6"/>
                                                                                </ItemsPanelTemplate>
                                                                        </ListBox.ItemsPanel>
                                                                        <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                        <StackPanel Height="148" Margin="6" VerticalAlignment="Stretch">
                                                                                                <Border Height="108" Background="#20242A" BorderBrush="#343A43" BorderThickness="1" CornerRadius="6">
                                                                                                        <Image Source="{Binding IconUrl}" Stretch="Uniform" Margin="8"/>
                                                                                                </Border>
                                                                                                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,8,0,0"/>
                                                                                        </StackPanel>
                                                                                </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                </ListBox>
                                                        </Grid>

                                                        <Button Grid.Row="3" Content="Launch Selected App" Height="42" Margin="0,12,0,0" Click="LaunchSelectedAppButton_Click"/>
                                                </Grid>
                                        </Border>
                                </Grid>
                        </TabItem>


                        <TabItem Header="Settings">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16">
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                        <StackPanel>
                                                                <TextBlock Text="Casting Defaults" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Choose the shared defaults used by every new Link, Live, and Folder cast." TextWrapping="Wrap" Opacity="0.78" Margin="0,0,0,16"/>
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="18"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                                <TextBlock Text="Preferred encoder" FontWeight="SemiBold"/>
                                                                                <ComboBox x:Name="SettingsEncoderComboBox" Height="34" Margin="0,6,0,14"/>
                                                                                <TextBlock Text="Default frame rate" FontWeight="SemiBold"/>
                                                                                <ComboBox x:Name="SettingsFpsComboBox" Height="34" Margin="0,6,0,0">
                                                                                        <ComboBoxItem Content="30"/>
                                                                                        <ComboBoxItem Content="60"/>
                                                                                </ComboBox>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="Default video quality" FontWeight="SemiBold"/>
                                                                                <ComboBox x:Name="SettingsBitrateComboBox" Height="34" Margin="0,6,0,14">
                                                                                        <ComboBoxItem Content="4000 kbps"/>
                                                                                        <ComboBoxItem Content="8000 kbps"/>
                                                                                        <ComboBoxItem Content="12000 kbps"/>
                                                                                        <ComboBoxItem Content="18000 kbps"/>
                                                                                </ComboBox>
                                                                                <TextBlock Text="Default PC audio source" FontWeight="SemiBold"/>
                                                                                <ComboBox x:Name="SettingsAudioSourceComboBox" Height="34" Margin="0,6,0,0"/>
                                                                                <Button Content="Refresh PC Audio Sources" HorizontalAlignment="Left" Padding="14,6" Margin="0,10,0,0" Click="RefreshAudioDevicesButton_Click"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                                <CheckBox x:Name="SettingsIncludeAudioCheckBox" Content="Stream PC audio by default for new Live Casts" Margin="0,16,0,0"/>
                                                        </StackPanel>
                                                </Border>

                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                                        <StackPanel>
                                                                <TextBlock Text="Roku Private Listening" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Listening speaker" FontWeight="SemiBold"/>
                                                                <TextBlock Text="Windows default playback device" Margin="0,6,0,4"/>
                                                                <TextBlock Text="Private Listening sends Roku audio to the Windows playback device marked as Default. Change that device in Windows Sound settings—for example, to switch between speakers and headphones." TextWrapping="Wrap" Opacity="0.78" Margin="0,0,0,12"/>
                                                                <Button Content="Open Windows Sound Settings" HorizontalAlignment="Left" Padding="14,6" Click="OpenWindowsSoundSettingsButton_Click"/>
                                                        </StackPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal">
                                                        <Button Content="Save and Apply Defaults" Height="42" Padding="18,6" Click="SaveAndApplySettingsButton_Click"/>
                                                        <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.78"/>
                                                </StackPanel>
                                        </StackPanel>
                                </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Changelog">
                                <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Dowe LanCaster Changelog" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock Text="Release notes included with this version of Dowe LanCaster." Opacity="0.78" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <WebBrowser x:Name="ChangelogBrowser" Grid.Row="1"/>
                                </Grid>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                                <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Dowe LanCaster Diagnostics" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <TextBox x:Name="DiagnosticsTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="Diagnostics will appear here."/>
                                </Grid>
                        </TabItem>

                </TabControl>

                <StatusBar Grid.Row="3" Margin="0,12,0,0">
                        <StatusBarItem>
                                <TextBlock x:Name="StatusText" Text="Ready. Scan for Roku devices."/>
                        </StatusBarItem>
                </StatusBar>
        </Grid>
</Window>
