<Window x:Class="DoweLanCaster.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dowe LanCaster Remote"
        Width="440"
        Height="760"
        MinWidth="340"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="White">
    <Window.Resources>
        <Style x:Key="RemoteRoundButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2E35"/>
            <Setter Property="BorderBrush" Value="#454B55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoteButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RemoteButtonBorder" Property="Background" Value="#3A414B"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="RemoteButtonBorder" Property="Background" Value="#149EC2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RemoteButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RemoteAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource RemoteRoundButtonStyle}">
            <Setter Property="Background" Value="#15AFCF"/>
            <Setter Property="BorderBrush" Value="#3FE1FF"/>
            <Setter Property="Foreground" Value="#06151B"/>
        </Style>
        <Style x:Key="RemotePowerButtonStyle" TargetType="Button" BasedOn="{StaticResource RemoteRoundButtonStyle}">
            <Setter Property="Background" Value="#A83A3A"/>
            <Setter Property="BorderBrush" Value="#EE7777"/>
        </Style>
    </Window.Resources>
    <Border Margin="14" BorderBrush="#454B55" BorderThickness="1" CornerRadius="32" Padding="18" SnapsToDevicePixels="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2A2E35" Offset="0"/>
                <GradientStop Color="#15181D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.35"/>
        </Border.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#15181D" BorderBrush="#454B55" BorderThickness="1" CornerRadius="20" Padding="12,8" HorizontalAlignment="Stretch" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="DoweLanCaster.ico" Width="32" Height="32" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DOWE LANCASTER" Foreground="#15AFCF" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="DeviceText" Text="ROKU REMOTE" Foreground="#AAB3BE" FontSize="9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Button Content="↩ Back" Style="{StaticResource RemoteRoundButtonStyle}" Tag="Back" Margin="3,0" Height="42" Click="RemoteButton_Click"/>
                    <Button Content="⌂ Home" Style="{StaticResource RemoteAccentButtonStyle}" Tag="Home" Margin="3,0" Height="42" Click="RemoteButton_Click"/>
                    <Button Content="↶ Replay" Style="{StaticResource RemoteRoundButtonStyle}" Tag="InstantReplay" Margin="3,0" Height="42" Click="RemoteButton_Click"/>
                    <Button Content="⏻ Power" Style="{StaticResource RemotePowerButtonStyle}" Tag="Power" Margin="3,0" Height="42" Click="RemoteButton_Click"/>
                </UniformGrid>

                <Border Background="#15181D" BorderBrush="#454B55" BorderThickness="2" CornerRadius="102" Width="204" Height="204" HorizontalAlignment="Center" Padding="10" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="1" Content="▲" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Tag="Up" Click="RemoteButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="◀" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Tag="Left" Click="RemoteButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="OK" FontSize="18" Style="{StaticResource RemoteAccentButtonStyle}" Margin="2" Tag="Select" Click="RemoteButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="▶" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Tag="Right" Click="RemoteButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="▼" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="4" Tag="Down" Click="RemoteButton_Click"/>
                </Grid>
                </Border>

                <Border Background="#15181D" BorderBrush="#454B55" BorderThickness="1" CornerRadius="20" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <Button Content="⏪" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="3" Height="42" Tag="Rev" Click="RemoteButton_Click"/>
                            <Button Content="⏯" FontSize="21" Style="{StaticResource RemoteRoundButtonStyle}" Margin="3" Height="42" Tag="Play" Click="RemoteButton_Click"/>
                            <Button Content="⏩" FontSize="20" Style="{StaticResource RemoteRoundButtonStyle}" Margin="3" Height="42" Tag="Fwd" Click="RemoteButton_Click"/>
                        </UniformGrid>
                        <UniformGrid Columns="3">
                            <Button Content="Vol −" Style="{StaticResource RemoteRoundButtonStyle}" Margin="3" Height="42" Tag="VolumeDown" Click="RemoteButton_Click"/>
                            <Button Content="Mute" Style="{StaticResource RemoteRoundButtonStyle}" Margin="3" Height="42" Tag="VolumeMute" Click="RemoteButton_Click"/>
                            <Button Content="Vol +" Style="{StaticResource RemoteRoundButtonStyle}" Margin="3" Height="42" Tag="VolumeUp" Click="RemoteButton_Click"/>
                        </UniformGrid>
                        <Grid Margin="3,6,3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VolumeTextBox" Text="25" Height="38" Padding="12,0" VerticalContentAlignment="Center" ToolTip="Roku TV volume, from 0 to 100"/>
                            <Button Grid.Column="1" Content="Set Volume" Style="{StaticResource RemoteAccentButtonStyle}" Margin="6,0,0,0" Height="38" Click="SetVolumeButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="PrivateListeningButton" Visibility="Collapsed" Content="Start Roku Private Listening" Click="PrivateListeningButton_Click"/>
                <Button x:Name="VoiceControlButton" Visibility="Collapsed" Content="Start Voice Control" Click="VoiceControlButton_Click"/>

                <Border Background="#15181D" BorderBrush="#454B55" BorderThickness="1" CornerRadius="18" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Keyboard Text" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RokuTextInput" Height="40" Padding="12,0" FontSize="14" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Send Text to Roku" Style="{StaticResource RemoteAccentButtonStyle}" Height="40" Margin="6,0,0,0" Click="SendTextButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#AAB3BE" TextAlignment="Center" TextWrapping="Wrap" Margin="4,12,4,0"/>
    </Grid>
    </Border>
</Window>
