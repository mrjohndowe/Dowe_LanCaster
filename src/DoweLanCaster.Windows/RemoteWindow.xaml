<Window x:Class="DoweLanCaster.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dowe LanCaster Remote"
        Width="420"
        Height="690"
        MinWidth="340"
        MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#15181D"
        Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="DOWE LANCASTER" Foreground="#4EDCFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DeviceText" Text="ROKU REMOTE" Foreground="#AAB3BE" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Button Content="Back" Tag="Back" Margin="4" Height="44" Click="RemoteButton_Click"/>
                    <Button Content="Home" Tag="Home" Margin="4" Height="44" Click="RemoteButton_Click"/>
                    <Button Content="Replay" Tag="InstantReplay" Margin="4" Height="44" Click="RemoteButton_Click"/>
                    <Button Content="Power" Tag="Power" Margin="4" Height="44" Click="RemoteButton_Click"/>
                </UniformGrid>

                <Grid Width="250" Height="250" HorizontalAlignment="Center" Margin="0,2,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="1" Content="▲" FontSize="24" Margin="5" Tag="Up" Click="RemoteButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="◀" FontSize="24" Margin="5" Tag="Left" Click="RemoteButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="OK" FontSize="18" Margin="5" Tag="Select" Click="RemoteButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="▶" FontSize="24" Margin="5" Tag="Right" Click="RemoteButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="▼" FontSize="24" Margin="5" Tag="Down" Click="RemoteButton_Click"/>
                </Grid>

                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Button Content="⏪" FontSize="20" Margin="4" Height="44" Tag="Rev" Click="RemoteButton_Click"/>
                    <Button Content="⏯" FontSize="20" Margin="4" Height="44" Tag="Play" Click="RemoteButton_Click"/>
                    <Button Content="⏩" FontSize="20" Margin="4" Height="44" Tag="Fwd" Click="RemoteButton_Click"/>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Button Content="Vol −" Margin="4" Height="42" Tag="VolumeDown" Click="RemoteButton_Click"/>
                    <Button Content="Mute" Margin="4" Height="42" Tag="VolumeMute" Click="RemoteButton_Click"/>
                    <Button Content="Vol +" Margin="4" Height="42" Tag="VolumeUp" Click="RemoteButton_Click"/>
                </UniformGrid>

                <Grid Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VolumeTextBox" Text="25" Height="40" Padding="12,0" VerticalContentAlignment="Center" ToolTip="Roku TV volume, from 0 to 100"/>
                    <Button Grid.Column="1" Content="Set Volume" Margin="8,0,0,0" Height="40" Click="SetVolumeButton_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#AAB3BE" TextAlignment="Center" TextWrapping="Wrap" Margin="4,12,4,0"/>
    </Grid>
</Window>
