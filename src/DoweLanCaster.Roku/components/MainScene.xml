<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="streamUrl" type="string" onChange="onStreamUrlChanged"/>
        <field id="mediaType" type="string"/>
        <field id="controlUrl" type="string"/>
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Rectangle
            id="background"
            width="1280"
            height="720"
            translation="[0,0]"
            color="0x000000FF" />

        <Video
            id="launchVideo"
            width="1280"
            height="720"
            translation="[0,0]"
            visible="true" />

        <Group
            id="waitingGroup"
            opacity="0"
            visible="false">
        <Poster
            id="waitingScreen"
            width="1280"
            height="720"
            translation="[0,0]"
            uri="pkg:/images/waiting-screen.png"
            loadDisplayMode="scaleToFill"
            visible="false" />

        <Label
            id="waitingTitle"
            width="1000"
            height="80"
            translation="[140,150]"
            horizAlign="center"
            vertAlign="center"
            color="0x4EDCFFFF"
            text="DOWE LANCASTER"
            visible="false" />

        <Label
            id="waitingSubtitle"
            width="1000"
            height="60"
            translation="[140,230]"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            text="Waiting for a stream"
            visible="false" />

        <Label
            id="waitingInstructions"
            width="1000"
            height="190"
            translation="[140,320]"
            horizAlign="center"
            vertAlign="center"
            wrap="true"
            numLines="4"
            color="0xD8E4EEFF"
            text="1. Open Dowe LanCaster on your Windows PC&#10;2. Select this Roku device&#10;3. Choose Link Cast, Live Cast, File Cast, or Folder Cast"
            visible="false" />

        <Label
            id="waitingHint"
            width="1000"
            height="50"
            translation="[140,545]"
            horizAlign="center"
            vertAlign="center"
            color="0x7EDFF5FF"
            text="Keep this screen open while connecting"
            visible="false" />
        </Group>

        <Animation
            id="waitingFadeAnimation"
            duration="0.85"
            repeat="false"
            easeFunction="outQuad">
            <FloatFieldInterpolator
                key="[0.0,1.0]"
                keyValue="[0.0,1.0]"
                fieldToInterp="waitingGroup.opacity" />
        </Animation>

        <Video
            id="videoPlayer"
            width="1280"
            height="720"
            translation="[0,0]"
            visible="false" />

        <Label
            id="statusLabel"
            width="800"
            height="120"
            translation="[240,300]"
            horizAlign="center"
            vertAlign="center"
            color="0xFFFFFFFF"
            visible="false"
            text="" />

        <Timer id="folderControlTimer" duration="1" repeat="true" />
    </children>
</component>
